{
  "compilerOptions": {
    "target": "ES2020",

    "module": "NodeNext",
    "moduleResolution": "NodeNext",

    "rootDir": "./src",
    "outDir": "./dist",

    "strict": true,

    "esModuleInterop": true,

    "skipLibCheck": true,

    "sourceMap": true,

    "resolveJsonModule": true,

    "forceConsistentCasingInFileNames": true,

    "noImplicitOverride": true,

    "noUncheckedIndexedAccess": true,

    "types": ["node"],

    "typeRoots": [
      "./src/types",
      "./node_modules/@types"
    ]
  },

  "include": [
    "src"
  ]
}